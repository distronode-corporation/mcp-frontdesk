{
  "name": "mcp-frontdesk",
  "version": "0.1.0",
  "description": "A small OAuth 2.1 authorization server and access-token gate for MCP servers: Client ID Metadata Documents, PKCE, rotating refresh tokens, built on Web Request and Response.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "oauth",
    "oauth2",
    "authorization-server",
    "cimd",
    "pkce",
    "claude"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/distronode-corporation/mcp-frontdesk.git"
  },
  "license": "Apache-2.0",
  "author": "Distronode Corporation",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./experimental": {
      "types": "./dist/experimental.d.ts",
      "default": "./dist/experimental.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/",
    "README.md",
    "SECURITY-MODEL.md",
    "SECURITY.md",
    "SPEC.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/clean.mjs && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test --test-reporter=spec \"test/**/*.test.ts\"",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include=\"src/**\" --test-coverage-lines=100 --test-coverage-branches=100 --test-coverage-functions=100 \"test/**/*.test.ts\"",
    "prepack": "npm run build"
  },
  "dependencies": {
    "jose": "6.2.17"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "7.0.2"
  }
}
